[gd_resource type="FontVariation" load_steps=4 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/SourceSans3-Regular.otf" id="1"]
[ext_resource type="FontFile" path="res://assets/fonts/SoulboundUISymbols.ttf" id="2"]

[ext_resource type="FontFile" path="res://assets/fonts/SoulboundUISigns.ttf" id="3"]

[resource]
base_font = ExtResource("1")
# Source Sans defaults to tabular lining figures; explicitly keep pnum disabled.
opentype_features = {"pnum": 0, "onum": 0}
fallbacks = [ExtResource("2"), ExtResource("3")]
